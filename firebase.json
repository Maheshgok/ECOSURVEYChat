{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/chatbot/ecosurveybudget2026/api/**",
        "run": {
          "serviceId": "ecosurvey-backend",
          "region": "asia-south1"
        }
      },
      {
        "source": "/chatbot/ecosurveybudget2026/**",
        "destination": "/chatbot/ecosurveybudget2026/index.html"
      },
      {
        "source": "/**",
        "destination": "/chatbot/ecosurveybudget2026/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
