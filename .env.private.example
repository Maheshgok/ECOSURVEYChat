# ===================================================================
# Private Cloud / On-Premise (Custom JWT + Postgres)
# ===================================================================
DEPLOYMENT_PROFILE=private

# Custom JWT authentication (your own IdP)
AUTH_PROVIDER=custom_jwt
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ISSUER=https://your-idp.example.com

# PostgreSQL (session storage + analytics)
DATABASE_URL=postgresql://user:password@postgres-host:5432/rag_db

# Pinecone (vector database)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=economic-survey-2026

# OpenAI
OPENAI_API_KEY=your-openai-key

# Optional: Redis for faster session caching
# REDIS_HOST=redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Optional: Enable metrics and A/B testing
ENABLE_METRICS=true
ENABLE_AB_TESTING=false

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
