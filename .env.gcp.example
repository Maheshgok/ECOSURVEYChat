# ===================================================================
# GCP Deployment (Firebase + Firestore) - ZERO CONFIG DEFAULT
# ===================================================================
DEPLOYMENT_PROFILE=gcp

# Firebase (authentication + session storage)
FIREBASE_PROJECT_ID=your-project-id
# No keys needed! Uses Application Default Credentials on Cloud Run

# Pinecone (vector database - works on all clouds)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX_NAME=economic-survey-2026

# OpenAI
OPENAI_API_KEY=your-openai-key

# Optional: Enable metrics and A/B testing
ENABLE_METRICS=true
ENABLE_AB_TESTING=false

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
