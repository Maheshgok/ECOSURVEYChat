# Economic Survey Practitioner Chat v1.2
# Environment Configuration
# Copy this to .env and fill in your values

# ============================================================================
# DATABASE
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=survey_chat
DB_USER=survey_user
DB_PASSWORD=changeme_secure_password_here
DATABASE_URL=postgresql://survey_user:changeme_secure_password_here@postgres:5432/survey_chat

# ============================================================================
# GOOGLE OAUTH (DEPRECATED - Use Firebase instead)
# ============================================================================
# GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ============================================================================
# FIREBASE (Authentication & Session Management) - NO KEYS NEEDED! ✅
# ============================================================================
# Get Firebase Project ID from: Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id

# RECOMMENDED: Use Application Default Credentials (NO SERVICE ACCOUNT KEYS!)
# This is Google's recommended approach and works automatically.
#
# Local Development:
#   1. Run: gcloud auth application-default login
#   2. Run: gcloud config set project your-firebase-project-id
#   3. That's it! No keys needed.
#
# Cloud Run Production:
#   Automatic! Cloud Run service account has built-in access.
#   Just set FIREBASE_PROJECT_ID above.
#
# ONLY set these if you have organizational policy blocking ADC:
# FIREBASE_CREDENTIALS_PATH=backend/firebase-service-account.json  # For local
# FIREBASE_CREDENTIALS_JSON={"type":"service_account"...}          # For Cloud Run

# ============================================================================
# SESSION & SECURITY
# ============================================================================
SESSION_SECRET=your_random_session_secret_at_least_32_chars_long
SERVER_SALT=your_random_server_salt_for_pseudo_id_hashing

# ============================================================================
# LLM API (OpenAI or Anthropic)
# ============================================================================
# For OpenAI:
OPENAI_API_KEY=sk-your_openai_api_key_here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-large

# For Anthropic (uncomment to use):
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-opus-20240229

# ============================================================================
# FRONTEND
# ============================================================================
FRONTEND_URL=http://localhost:3000
FRONTEND_API_URL=http://localhost:8000

# ============================================================================
# GCP (Production Deployment)
# ============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# ============================================================================
# APPLICATION CONFIG
# ============================================================================
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# CONTEXT PACK & INGESTION
# ============================================================================
CONTEXT_BUDGET_TOKENS=10000
CONTEXT_QUOTA_CONVERSATION=500
CONTEXT_QUOTA_CLAIMS=1500
CONTEXT_QUOTA_NARRATIVE=4000
CONTEXT_QUOTA_DATA=4000
SUPPLEMENT_QUOTA_PERCENT=25

# ============================================================================
# INGESTION MODES
# ============================================================================
# Set to "strict" to fail on naming pattern violations
# Set to "skip" (default) to skip and log warnings
INGESTION_MODE=skip
