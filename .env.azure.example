# ===================================================================
# Azure Deployment (Azure AD + Cosmos DB + AI Search)
# ===================================================================
DEPLOYMENT_PROFILE=azure

# Azure AD (authentication)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# Azure Cosmos DB (session storage)
COSMOS_DB_URI=https://your-account.documents.azure.com:443/
COSMOS_DB_KEY=your-cosmos-key
COSMOS_DB_NAME=rag_sessions

# Azure AI Search (vector database - optional, can use Pinecone)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-search-key
AZURE_SEARCH_INDEX=rag-vectors

# OR use Pinecone instead (works on Azure too)
# VECTOR_PROVIDER=pinecone
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_INDEX_NAME=economic-survey-2026

# OpenAI
OPENAI_API_KEY=your-openai-key

# Optional: Enable metrics and A/B testing
ENABLE_METRICS=true
ENABLE_AB_TESTING=false

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
DEBUG=false
